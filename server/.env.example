# ─── Server Configuration ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend Application URL (Used in email templates and reset password links)
APP_URL=http://localhost:5173

# ─── PostgreSQL (Neon Cloud or Local) ────────────────────────────────────────
DATABASE_URL=
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=api_monitoring
PG_USER=your_pg_user
PG_PASSWORD=your_pg_password
PG_SSL=false

# ─── MongoDB (Atlas Cloud or Local) ──────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/api_monitoring
MONGO_DB_NAME=api_monitoring

# ─── RabbitMQ (CloudAMQP or Local) ───────────────────────────────────────────
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE=api_hits
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=1000

# ─── Authentication & Security ──────────────────────────────────────────────
JWT_SECRET=replace_with_a_secure_random_64_character_string
JWT_EXPIRES_IN=24h

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ─── Email & SMTP (e.g. Brevo, Zoho, AWS SES, or standard SMTP) ─────────────
# Example hosts: smtp-relay.brevo.com, smtp.zoho.in, smtp.gmail.com
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=ObserveX <notifications@observex.io>
